{
    "name": "shirakaba/http-message",
    "description": "PSR-7 HTTP message and PSR-17 factory implementation of the Shirakaba framework.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "provide": {
        "psr/http-factory-implementation": "1.0",
        "psr/http-message-implementation": "2.0"
    },
    "require-dev": {
        "php-http/psr7-integration-tests": "^1.5",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Shirakaba\\Http\\Message\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\Http\\Message\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
