{
    "name": "shirakaba/trusted-proxy",
    "description": "Applies forwarding headers from trusted reverse proxies (RFC 7239 and X-Forwarded-*), restricts hosts and builds URLs on a canonical origin.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "shirakaba/core": "^0.1",
        "shirakaba/http-message": "^0.1",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Shirakaba\\TrustedProxy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\TrustedProxy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
