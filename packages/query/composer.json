{
    "name": "shirakaba/query",
    "description": "Typed, immutable SQL query builder for MySQL, PostgreSQL and SQLite over shirakaba/database.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "shirakaba/database": "^0.1",
        "shirakaba/time": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Shirakaba\\Query\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\Query\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
