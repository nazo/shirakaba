{
    "name": "shirakaba/session-redis",
    "description": "A session store in Redis, shared by every instance and expired by Redis itself.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "shirakaba/core": "^0.1",
        "shirakaba/redis": "^0.1",
        "shirakaba/session": "^0.1",
        "shirakaba/time": "^0.1",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Shirakaba\\SessionRedis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\SessionRedis\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
