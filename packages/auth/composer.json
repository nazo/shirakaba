{
    "name": "shirakaba/auth",
    "description": "Bearer authentication and minimal JWT verification for Shirakaba.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-openssl": "*",
        "shirakaba/core": "^0.1",
        "shirakaba/time": "^0.1",
        "psr/clock": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Shirakaba\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\Auth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
