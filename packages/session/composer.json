{
    "name": "shirakaba/session",
    "description": "Worker-safe sessions, secure cookies, flash messages and CSRF protection for Shirakaba.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "shirakaba/core": "^0.1",
        "shirakaba/time": "^0.1",
        "psr/clock": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Shirakaba\\Session\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\Session\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
