{
    "name": "shirakaba/redis",
    "description": "A small Redis client: RESP over a socket with TLS, AUTH, timeouts and Lua scripts, without extensions.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Shirakaba\\Redis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\Redis\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
