{
    "name": "shirakaba/database-bridge",
    "description": "Connects the Shirakaba database packages to the framework: connections leased per request, #[Db] parameters, observer events, HTTP errors for entities, and the entity and migration commands.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "shirakaba/console": "^0.1",
        "shirakaba/core": "^0.1",
        "shirakaba/database": "^0.1",
        "shirakaba/migrations": "^0.1",
        "shirakaba/orm": "^0.1",
        "shirakaba/time": "^0.1",
        "psr/clock": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "bin": [
        "bin/shirakaba-migrate"
    ],
    "autoload": {
        "psr-4": {
            "Shirakaba\\DatabaseBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\DatabaseBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
