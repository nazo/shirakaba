{
    "name": "shirakaba/runtime-swoole",
    "description": "Runs a Shirakaba (or any PSR-15) application on a Swoole HTTP server.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "shirakaba/core": "^0.1",
        "shirakaba/http-message": "^0.1",
        "shirakaba/sapi": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "shirakaba/streaming": "^0.1",
        "swoole/ide-helper": "^6.2"
    },
    "suggest": {
        "ext-swoole": "Required to run the server (6.2.5 or later)"
    },
    "autoload": {
        "psr-4": {
            "Shirakaba\\Runtime\\Swoole\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\Runtime\\Swoole\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
