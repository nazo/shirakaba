{
    "name": "shirakaba/query-cache",
    "description": "Opt-in query result caching over PSR-16 with tag invalidation after commit.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "shirakaba/database": "^0.1",
        "shirakaba/query": "^0.1",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Shirakaba\\QueryCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\QueryCache\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
