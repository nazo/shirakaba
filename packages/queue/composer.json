{
    "name": "shirakaba/queue",
    "description": "Background jobs for Shirakaba: JSON job DTOs, a transactional database queue with leases, retries with backoff, and workers.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "shirakaba/console": "^0.1",
        "shirakaba/core": "^0.1",
        "shirakaba/database": "^0.1",
        "shirakaba/json": "^0.1",
        "shirakaba/migrations": "^0.1",
        "shirakaba/query": "^0.1",
        "shirakaba/time": "^0.1",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "shirakaba/database-bridge": "^0.1",
        "shirakaba/opentelemetry": "^0.1",
        "open-telemetry/api": "^1.11",
        "open-telemetry/sdk": "^1.16"
    },
    "suggest": {
        "open-telemetry/api": "Carries the enqueuing request's trace into the job"
    },
    "autoload": {
        "psr-4": {
            "Shirakaba\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\Queue\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
