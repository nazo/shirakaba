{
    "name": "shirakaba/time",
    "description": "Clocks (PSR-20) and calendar types with strict, timezone-explicit parsing and formatting.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Shirakaba\\Time\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\Time\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
