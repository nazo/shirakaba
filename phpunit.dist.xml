<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         executionOrder="random"
         requireCoverageMetadata="false"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutCoverageMetadata="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         displayDetailsOnAllIssues="true">
    <testsuites>
        <testsuite name="packages">
            <directory>packages/*/tests</directory>
        </testsuite>
        <testsuite name="examples">
            <directory>examples/*/tests</directory>
        </testsuite>
        <testsuite name="conformance">
            <directory>tests/conformance</directory>
        </testsuite>
        <testsuite name="tools">
            <directory>tools/monorepo/tests</directory>
            <directory>tools/docs/tests</directory>
            <directory>tools/repository/tests</directory>
        </testsuite>
    </testsuites>
    <source restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>packages/*/src</directory>
            <directory>tools/monorepo/src</directory>
            <directory>tools/docs/src</directory>
            <directory>tools/repository/src</directory>
            <directory>examples/*/src</directory>
        </include>
    </source>
</phpunit>
