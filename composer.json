{
    "name": "shirakaba/shirakaba",
    "description": "Development monorepo for the Shirakaba web application framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-uri": "*",
        "composer-runtime-api": "^2.2",
        "open-telemetry/api": "^1.11",
        "open-telemetry/context": "^1.6",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "roadrunner/worker": "^3.8",
        "spiral/roadrunner-http": "^4.2"
    },
    "replace": {
        "shirakaba/auth": "self.version",
        "shirakaba/console": "self.version",
        "shirakaba/core": "self.version",
        "shirakaba/cors": "self.version",
        "shirakaba/database": "self.version",
        "shirakaba/database-bridge": "self.version",
        "shirakaba/docs": "self.version",
        "shirakaba/form": "self.version",
        "shirakaba/http-client": "self.version",
        "shirakaba/http-message": "self.version",
        "shirakaba/json": "self.version",
        "shirakaba/log": "self.version",
        "shirakaba/mailer": "self.version",
        "shirakaba/mailer-queue": "self.version",
        "shirakaba/migrations": "self.version",
        "shirakaba/openapi": "self.version",
        "shirakaba/opentelemetry": "self.version",
        "shirakaba/orm": "self.version",
        "shirakaba/phpstan": "self.version",
        "shirakaba/pubsub": "self.version",
        "shirakaba/query": "self.version",
        "shirakaba/query-cache": "self.version",
        "shirakaba/queue": "self.version",
        "shirakaba/queue-redis": "self.version",
        "shirakaba/rate-limit": "self.version",
        "shirakaba/redis": "self.version",
        "shirakaba/runtime-fpm": "self.version",
        "shirakaba/runtime-frankenphp": "self.version",
        "shirakaba/runtime-roadrunner": "self.version",
        "shirakaba/runtime-swoole": "self.version",
        "shirakaba/sapi": "self.version",
        "shirakaba/session": "self.version",
        "shirakaba/session-database": "self.version",
        "shirakaba/session-redis": "self.version",
        "shirakaba/streaming": "self.version",
        "shirakaba/template": "self.version",
        "shirakaba/time": "self.version",
        "shirakaba/trusted-proxy": "self.version",
        "shirakaba/validation": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Shirakaba\\Auth\\": "packages/auth/src/",
            "Shirakaba\\Core\\": "packages/core/src/",
            "Shirakaba\\Cors\\": "packages/cors/src/",
            "Shirakaba\\Database\\": "packages/database/src/",
            "Shirakaba\\DatabaseBridge\\": "packages/database-bridge/src/",
            "Shirakaba\\Form\\": "packages/form/src/",
            "Shirakaba\\Http\\Message\\": "packages/http-message/src/",
            "Shirakaba\\Json\\": "packages/json/src/",
            "Shirakaba\\Log\\": "packages/log/src/",
            "Shirakaba\\OpenTelemetry\\": "packages/opentelemetry/src/",
            "Shirakaba\\PHPStan\\": "packages/phpstan/src/",
            "Shirakaba\\OpenApi\\": "packages/openapi/src/",
            "Shirakaba\\Redis\\": "packages/redis/src/",
            "Shirakaba\\Runtime\\Fpm\\": "packages/runtime-fpm/src/",
            "Shirakaba\\Runtime\\FrankenPhp\\": "packages/runtime-frankenphp/src/",
            "Shirakaba\\Runtime\\RoadRunner\\": "packages/runtime-roadrunner/src/",
            "Shirakaba\\Runtime\\Swoole\\": "packages/runtime-swoole/src/",
            "Shirakaba\\Sapi\\": "packages/sapi/src/",
            "Shirakaba\\Session\\": "packages/session/src/",
            "Shirakaba\\SessionDatabase\\": "packages/session-database/src/",
            "Shirakaba\\SessionRedis\\": "packages/session-redis/src/",
            "Shirakaba\\Streaming\\": "packages/streaming/src/",
            "Shirakaba\\TrustedProxy\\": "packages/trusted-proxy/src/",
            "Shirakaba\\Validation\\": "packages/validation/src/",
            "Shirakaba\\Template\\": "packages/template/src/",
            "Shirakaba\\Time\\": "packages/time/src/",
            "Shirakaba\\Query\\": "packages/query/src/",
            "Shirakaba\\Orm\\": "packages/orm/src/",
            "Shirakaba\\Mailer\\": "packages/mailer/src/",
            "Shirakaba\\MailerQueue\\": "packages/mailer-queue/src/",
            "Shirakaba\\Migrations\\": "packages/migrations/src/",
            "Shirakaba\\QueryCache\\": "packages/query-cache/src/",
            "Shirakaba\\Console\\": "packages/console/src/",
            "Shirakaba\\Queue\\": "packages/queue/src/",
            "Shirakaba\\QueueRedis\\": "packages/queue-redis/src/",
            "Shirakaba\\Docs\\": "packages/docs/src/",
            "Shirakaba\\PubSub\\": "packages/pubsub/src/",
            "Shirakaba\\HttpClient\\": "packages/http-client/src/",
            "Shirakaba\\RateLimit\\": "packages/rate-limit/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shirakaba\\Examples\\Tasks\\": "examples/tasks/src/",
            "Shirakaba\\Examples\\Tasks\\Tests\\": "examples/tasks/tests/",
            "Shirakaba\\Conformance\\Tests\\": "tests/conformance/",
            "Shirakaba\\Auth\\Tests\\": "packages/auth/tests/",
            "Shirakaba\\Core\\Tests\\": "packages/core/tests/",
            "Shirakaba\\Cors\\Tests\\": "packages/cors/tests/",
            "Shirakaba\\Database\\Tests\\": "packages/database/tests/",
            "Shirakaba\\DatabaseBridge\\Tests\\": "packages/database-bridge/tests/",
            "Shirakaba\\Form\\Tests\\": "packages/form/tests/",
            "Shirakaba\\Http\\Message\\Tests\\": "packages/http-message/tests/",
            "Shirakaba\\Json\\Tests\\": "packages/json/tests/",
            "Shirakaba\\Log\\Tests\\": "packages/log/tests/",
            "Shirakaba\\OpenTelemetry\\Tests\\": "packages/opentelemetry/tests/",
            "Shirakaba\\PHPStan\\Tests\\": "packages/phpstan/tests/",
            "Shirakaba\\PHPStan\\Tests\\Fixtures\\": "packages/phpstan/tests/data/routes/",
            "Shirakaba\\OpenApi\\Tests\\": "packages/openapi/tests/",
            "Shirakaba\\Redis\\Tests\\": "packages/redis/tests/",
            "Shirakaba\\Runtime\\Fpm\\Tests\\": "packages/runtime-fpm/tests/",
            "Shirakaba\\Runtime\\FrankenPhp\\Tests\\": "packages/runtime-frankenphp/tests/",
            "Shirakaba\\Runtime\\RoadRunner\\Tests\\": "packages/runtime-roadrunner/tests/",
            "Shirakaba\\Runtime\\Swoole\\Tests\\": "packages/runtime-swoole/tests/",
            "Shirakaba\\Sapi\\Tests\\": "packages/sapi/tests/",
            "Shirakaba\\Session\\Tests\\": "packages/session/tests/",
            "Shirakaba\\SessionDatabase\\Tests\\": "packages/session-database/tests/",
            "Shirakaba\\SessionRedis\\Tests\\": "packages/session-redis/tests/",
            "Shirakaba\\Streaming\\Tests\\": "packages/streaming/tests/",
            "Shirakaba\\TrustedProxy\\Tests\\": "packages/trusted-proxy/tests/",
            "Shirakaba\\Validation\\Tests\\": "packages/validation/tests/",
            "Shirakaba\\Tools\\Monorepo\\": "tools/monorepo/src/",
            "Shirakaba\\Tools\\Monorepo\\Tests\\": "tools/monorepo/tests/",
            "Shirakaba\\Template\\Tests\\": "packages/template/tests/",
            "Shirakaba\\Time\\Tests\\": "packages/time/tests/",
            "Shirakaba\\Query\\Tests\\": "packages/query/tests/",
            "Shirakaba\\Orm\\Tests\\": "packages/orm/tests/",
            "Shirakaba\\Mailer\\Tests\\": "packages/mailer/tests/",
            "Shirakaba\\MailerQueue\\Tests\\": "packages/mailer-queue/tests/",
            "Shirakaba\\Migrations\\Tests\\": "packages/migrations/tests/",
            "Shirakaba\\Examples\\Tasks\\Migrations\\": "examples/tasks/migrations/",
            "Shirakaba\\PHPStan\\Tests\\Orm\\": "packages/phpstan/tests/data/orm/",
            "Shirakaba\\PHPStan\\Tests\\Scopes\\": "packages/phpstan/tests/data/scopes/",
            "Shirakaba\\QueryCache\\Tests\\": "packages/query-cache/tests/",
            "Shirakaba\\Console\\Tests\\": "packages/console/tests/",
            "Shirakaba\\Queue\\Tests\\": "packages/queue/tests/",
            "Shirakaba\\QueueRedis\\Tests\\": "packages/queue-redis/tests/",
            "Shirakaba\\Tools\\Docs\\": "tools/docs/src/",
            "Shirakaba\\Docs\\Tests\\": "packages/docs/tests/",
            "Shirakaba\\Tools\\Docs\\Tests\\": "tools/docs/tests/",
            "Shirakaba\\Tools\\Repository\\": "tools/repository/src/",
            "Shirakaba\\Tools\\Repository\\Tests\\": "tools/repository/tests/",
            "Shirakaba\\Tools\\PHPStan\\": "tools/phpstan/src/",
            "Shirakaba\\PubSub\\Tests\\": "packages/pubsub/tests/",
            "Shirakaba\\HttpClient\\Tests\\": "packages/http-client/tests/",
            "Shirakaba\\RateLimit\\Tests\\": "packages/rate-limit/tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false,
            "tbachert/spi": false,
            "infection/extension-installer": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "@php -d allow_url_fopen=0 vendor/bin/phpunit",
        "monorepo:validate": "php tools/monorepo/bin/validate",
        "monorepo:standalone": "php tools/monorepo/bin/test-standalone",
        "examples:openapi": "php packages/openapi/bin/shirakaba-openapi examples/tasks/app.php --config=examples/tasks/openapi.php --output=examples/tasks/openapi.json --strict",
        "examples:serve": "php -S 127.0.0.1:8080 examples/tasks/public/index.php",
        "bench": "@php -d opcache.enable_cli=1 -d opcache.jit=off -d zend.assertions=-1 tools/bench/run.php",
        "check": [
            "@monorepo:validate",
            "@format:check",
            "@analyse",
            "@test"
        ],
        "docs:generate": "php tools/docs/bin/generate",
        "repository:build": "php tools/repository/bin/build",
        "test:databases": "sh tools/databases/test.sh",
        "steins": "sh tools/steins/run.sh",
        "evals:reference": "php tools/evals/bin/run --reference",
        "infection": "infection --configuration=tools/infection/infection.json5 --threads=max",
        "format": "mago fmt",
        "format:check": "mago fmt --check"
    },
    "require-dev": {
        "carthage-software/mago": "^1.60",
        "infection/infection": "^0.35.12",
        "open-telemetry/sdk": "^1.16",
        "opis/json-schema": "^2.6",
        "php-http/psr7-integration-tests": "^1.5",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "shipmonk/dead-code-detector": "^1.4",
        "swoole/ide-helper": "^6.2",
        "typedduck/steins": "0.1.8"
    }
}
